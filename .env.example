# Supabase frontend configuration.
# Use the legacy anon key from Settings -> API Keys -> Legacy API Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_GOOGLE_AUTH=false

# Server-only configuration.
# Use the legacy service_role key for the current backend route.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
